# Copy to .env and fill in, or set these as GitHub Actions secrets.
# Never commit real values.

# --- Email delivery (required to actually send; otherwise preview only) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
REPORT_FROM=you@gmail.com
# Comma-separated list of recipients
REPORT_TO=you@gmail.com,teammate@example.com
REPORT_TITLE=Daily Crypto Market Report

# --- Optional tuning ---
# COINGECKO_API_KEY=            # demo key raises the rate limit; anonymous works fine once a day
# TOP_N_COINS=100
# MIN_EXPECTED_RECORDS=90
# STALE_HOURS=24
# MARKET_CAP_ALERT_PCT=5
